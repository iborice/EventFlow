{
    "family": "eventflow-web-staging",
    "networkMode": "awsvpc",
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "512",
    "memory": "1024",
    "executionRoleArn": "arn:aws:iam::923465947040:role/ecsTaskExecutionRole",
    "containerDefinitions": [
        {
            "name": "web",
            "image": "PLACEHOLDER",
            "essential": true,
            "portMappings": [
                {
                    "containerPort": 3000
                }
            ],
            "environment": [
                {
                    "name": "NEXT_PUBLIC_SITE_URL",
                    "value": "http://eventflow-staging-9256340.eu-north-1.elb.amazonaws.com"
                },
                {
                    "name": "EVENTFLOW_API_URL",
                    "value": "http://eventflow-staging-9256340.eu-north-1.elb.amazonaws.com/api/v1"
                },
                {
                    "name": "NEXT_PUBLIC_GOOGLE_ANALYTICS_ID",
                    "value": "G-PLACEHOLDER"
                }
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/eventflow-web-staging",
                    "awslogs-region": "eu-north-1",
                    "awslogs-stream-prefix": "app"
                }
            }
        }
    ]
}