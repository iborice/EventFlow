{
    "family": "eventflow-worker-staging",
    "networkMode": "awsvpc",
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "256",
    "memory": "512",
    "executionRoleArn": "arn:aws:iam::923465947040:role/ecsTaskExecutionRole",
    "containerDefinitions": [
        {
            "name": "worker",
            "image": "PLACEHOLDER",
            "essential": true,
            "stopTimeout": 120,
            "command": [
                "celery",
                "-A",
                "config",
                "worker",
                "--loglevel=info"
            ],
            "environment": [
                {
                    "name": "DJANGO_DEBUG",
                    "value": "false"
                },
                {
                    "name": "DJANGO_ALLOWED_HOSTS",
                    "value": "DNS_ALB"
                },
                {
                    "name": "POSTGRES_DB",
                    "value": "eventflow"
                },
                {
                    "name": "POSTGRES_HOST",
                    "value": "eventflow-staging.cjooka8skq4u.eu-north-1.rds.amazonaws.com"
                },
                {
                    "name": "POSTGRES_PORT",
                    "value": "5432"
                },
                {
                    "name": "CELERY_BROKER_URL",
                    "value": "redis://eventflow-staging-cache.wkpeai.ng.0001.eun1.cache.amazonaws.com:6379/0"
                },
                {
                    "name": "REDIS_URL",
                    "value": "redis://eventflow-staging-cache.wkpeai.ng.0001.eun1.cache.amazonaws.com:6379/1"
                },
                {
                    "name": "PUBLIC_SITE_URL",
                    "value": "http://eventflow-staging-9256340.eu-north-1.elb.amazonaws.com"
                },
                {
                    "name": "DJANGO_ALLOWED_HOSTS",
                    "value": "eventflow-staging-9256340.eu-north-1.elb.amazonaws.com"
                }
            ],
            "secrets": [
                {
                    "name": "DJANGO_SECRET_KEY",
                    "valueFrom": "arn:aws:secretsmanager:eu-north-1:923465947040:secret:staging/django-secret-key-ogFvCW"
                },
                {
                    "name": "POSTGRES_USER",
                    "valueFrom": "arn:aws:secretsmanager:eu-north-1:923465947040:secret:rds!db-e2cf18c9-8e5f-4e28-b2ce-8709e613f0b3-vVZMSp:username::"
                },
                {
                    "name": "POSTGRES_PASSWORD",
                    "valueFrom": "arn:aws:secretsmanager:eu-north-1:923465947040:secret:rds!db-e2cf18c9-8e5f-4e28-b2ce-8709e613f0b3-vVZMSp:password::"
                }
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/eventflow-worker-staging",
                    "awslogs-region": "eu-north-1",
                    "awslogs-stream-prefix": "app"
                }
            }
        }
    ]
}