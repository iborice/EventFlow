{
    "family": "eventflow-web-prod",
    "networkMode": "awsvpc",
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "512",
    "memory": "1024",
    "executionRoleArn": "arn:aws:iam::ACCOUNT_ID:role/ecsTaskExecutionRole",
    "containerDefinitions": [
        {
            "name": "web",
            "image": "PLACEHOLDER",
            "essential": true,
            "portMappings": [
                {
                    "containerPort": 3000
                }
            ],
            "environment": [
                {
                    "name": "NEXT_PUBLIC_SITE_URL",
                    "value": "http://DNS_ALB"
                },
                {
                    "name": "EVENTFLOW_API_URL",
                    "value": "http://DNS_ALB/api/v1"
                }
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/eventflow-web-prod",
                    "awslogs-region": "eu-west-3",
                    "awslogs-stream-prefix": "app"
                }
            }
        }
    ]
}